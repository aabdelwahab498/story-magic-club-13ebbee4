# ── backend-core environment variables ──────────────────────────────────────
# Copy to `.env` and fill in real values. The server validates these at
# bootstrap (see src/config/env.config.ts) and refuses to start if any
# required variable is missing or malformed.

# HTTP port the NestJS server listens on.
PORT=3000

# Runtime environment: development | production | test
NODE_ENV=development

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# NEVER expose the service-role key client-side. Backend/edge use only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── CORS (fail-closed) ───────────────────────────────────────────────────────
# REQUIRED. Comma-separated list of allowed origins. Only these origins are
# permitted for cross-origin requests. Do NOT hardcode production domains in
# source — configure them here per environment.
# Example (local dev): http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Mock LLM & Generative AI ─────────────────────────────────────────────────
USE_MOCK_LLM=false
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=30000

# ── Infrastructure Configuration ─────────────────────────────────────────────
# Redis Connection URL (for future queues / caching / checks)
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# Python AI Microservice endpoint URL
PYTHON_AI_URL=http://localhost:8000

# ── Security Credentials ─────────────────────────────────────────────────────
# JWT Secret / Audience / Issuer (if custom JWT validation is ever enabled)
# JWT_SECRET=your-jwt-signing-secret
# JWT_AUDIENCE=najmah-app
# JWT_ISSUER=najmah-auth

# ── Authentication & Email Confirmation ──────────────────────────────────────
# Server-controlled redirect URL after email confirmation link is clicked
# AUTH_EMAIL_CONFIRM_REDIRECT_URL=https://story-magic-club.lovable.app/auth/callback

# ── Google Integration API ───────────────────────────────────────────────────
# GOOGLE_API_KEY=your-google-api-key

# ── Provider Layers selection ────────────────────────────────────────────────
# Providers can be: 'google' | 'mock' | 'edge'
ILLUSTRATION_PROVIDER=google
AUDIO_PROVIDER=edge
IMAGE_PROVIDER=mock
MEDIA_IMAGE_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ── Resilience & Storage Configuration ──────────────────────────────────────
REQUEST_TIMEOUT=30000
RETRY_COUNT=3
STORAGE_BUCKETS=illustrations,audio,avatars,covers
