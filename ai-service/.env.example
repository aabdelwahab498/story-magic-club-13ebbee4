# ── ai-service environment variables ─────────────────────────────────────────
# Copy to `.env` and fill in real values. The server validates these at
# bootstrap (see app/config.py) and refuses to start if any required variables are missing.

# Port the FastAPI Uvicorn server listens on
PORT=8000
HOST=0.0.0.0

# Gemini AI Engine API Key (Required)
GEMINI_API_KEY=your-gemini-api-key
