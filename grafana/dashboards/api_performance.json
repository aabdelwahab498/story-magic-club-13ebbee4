          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50 (Median) Latency"
        }
      ]
    },
    {
      "title": "HTTP Status Distribution (Errors vs Successes)",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(http_errors_total[5m]))",
          "legendFormat": "Failed requests rate"
        },
        {
          "expr": "sum(rate(http_requests_total[5m])) - sum(rate(http_errors_total[5m]))",
          "legendFormat": "Successful requests rate"
        }
      ]
    },
    {
      "title": "Requests per Job Target",
      "type": "timeseries",
      "gridPos": {
        "h": 10,
        "w": 12,
