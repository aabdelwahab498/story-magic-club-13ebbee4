# ── Production Environment Configuration Template ────────────────────────────
# Copy this file to `.env.production` on your deployment host.

# ── Application Profile ──
NODE_ENV=production
PORT=3000

# ── Frontend SPA Configuration ──
VITE_API_URL=https://api.najmah.example.com
VITE_SUPABASE_URL=https://your-production.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-production-anon-key

# ── Supabase & Database Configuration ──
SUPABASE_URL=https://your-production.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# ── CORS Security ──
CORS_ALLOWED_ORIGINS=https://najmah.example.com,https://app.najmah.example.com

# ── AI Microservice & LLM API Configuration ──
PYTHON_AI_URL=http://ai-service:8000
GEMINI_API_KEY=your-production-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
USE_MOCK_LLM=false

# ── Media & Providers Selection ──
ILLUSTRATION_PROVIDER=google
AUDIO_PROVIDER=edge
STORAGE_BUCKETS=pdf_exports,audio,illustrations,avatars

# ── Session & JWT Parameters ──
JWT_SECRET=your-secure-jwt-signing-secret-change-this
JWT_AUDIENCE=najmah-app
JWT_ISSUER=najmah-auth
